  dialogueNodes:
  - npcDialogue: Hi. The room feels busy today.
    playerChoices:
    - playerChoice: What are you working on?
      stressChange: 0
      nextDialogueIndex: 1
      endsDialogue: 0
    - playerChoice: See you later.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
  - npcDialogue: Just my notes. I like writing things down so I can see them.
    playerChoices:
    - playerChoice: Thanks. Talk to you later.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
