<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Dialogue.uss?fileID=7433441132597879392&amp;guid=c2134a4ec5f9949729ebdb8ba041cb9d&amp;type=3#Dialogue"/>
    <ui:VisualElement name="dialogue" class="dialogue" style="background-color: rgba(0, 0, 0, 0.97);">
        <ui:VisualElement class="dialogue-text">
