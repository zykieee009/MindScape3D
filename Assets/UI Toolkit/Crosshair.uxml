<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- The dot in the middle of the view (PlayerMovement). Its size and colour come from the PlayerMovement component
         (Crosshair Size, Crosshair Color); keep the name. -->
    <ui:VisualElement name="crosshair" picking-mode="Ignore" style="position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; border-radius: 50%; background-color: rgb(255, 255, 255);"/>
</ui:UXML>
