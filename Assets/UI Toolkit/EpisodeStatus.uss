/* Time left and stress meter (EpisodeStatus.uxml).
   Sizes are in pixels at the 1280x720 reference resolution of EpisodePanelSettings.
   .mobile is added by code in mobile mode (MobileControls.Enabled). */

.hidden { display: none; }

/* Top centre. */
.status {
    --paper: #F2E8D1;
    --gold: #DBB36F;

    position: absolute;
    top: 21px;
    left: 50%;
    width: 280px;
    translate: -50% 0;
    padding: 9px 17px 9px 17px;
    background-color: rgba(29, 43, 47, 0.97);
    color: var(--paper);
    -unity-font-definition: resource("MinigameTheme/ComicNeue-Regular");
}

.status.mobile { width: 313px; }

/* pre-wrap keeps the double spaces ("TIME LEFT  11:50"). */
.status Label { padding: 0; margin: 0; white-space: pre-wrap; }

.status-timer {
    -unity-font-definition: resource("MainMenuNew/StorySerif");
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 7px;
}

/* Blinks on in the last minute (toggled by code). */
.status-timer.urgent { color: rgb(232, 150, 120); }

.status-row { flex-direction: row; align-items: center; }

.status-track {
    width: 62%;
    height: 21px;
    margin-right: 10px;
    background-color: rgb(16, 24, 27);
}

/* Width and colour are set by code from the stress level. */
.status-fill {
    width: 20%;
    height: 100%;
    background-color: rgb(65, 101, 99);
}

.status-stress { color: var(--gold); font-size: 15px; }
