.stress-hud {
    position: absolute;
    left: 24px;
    top: 22px;
    width: 300px;
    max-width: 45%;
    min-width: 180px;
    padding: 12px 16px 10px 16px;
    background-color: rgba(229, 214, 183, 0.96);
    border-left-width: 4px;
    border-left-color: rgb(156, 118, 62);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(184, 158, 113);
    border-right-color: rgb(184, 158, 113);
    border-bottom-color: rgb(184, 158, 113);
    border-radius: 6px;
}

.stress-topline,
.stress-bottomline {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.stress-title,
.stress-caption {
    color: rgb(80, 63, 43);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}

.stress-state {
    color: rgb(88, 112, 83);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.stress-critical-timer {
    margin-top: 6px;
    color: rgb(149, 58, 43);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.stress-track {
    position: relative;
    width: 100%;
    height: 10px;
    margin-top: 10px;
    margin-bottom: 8px;
    background-color: rgb(65, 53, 42);
    border-radius: 5px;
    overflow: hidden;
}

.stress-fill {
    height: 100%;
    min-width: 2px;
    background-color: rgb(88, 112, 83);
    border-radius: 5px;
}

.stress-tick {
    position: absolute;
    top: 0;
    width: 2px;
    height: 100%;
    background-color: rgb(229, 214, 183);
}

.tick-mid { left: 50%; }
.tick-high { left: 80%; }

.stress-value {
    color: rgb(52, 41, 31);
    font-size: 13px;
    -unity-font-style: bold;
}

.hidden { display: none; }

/* Tutorial places the meter where chapter episodes place their status HUD. */
.stress-hud.chapter-status {
    left: 610px;
    top: 21px;
    background-color: rgba(29, 43, 47, 0.97);
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
}

.chapter-status .stress-title,
.chapter-status .stress-caption { color: #DBB36F; }
.chapter-status .stress-value { color: #F2E8D1; }
.chapter-status .stress-track { background-color: rgb(16, 24, 27); }
