  dialogueNodes:
  - npcDialogue: Hi! Remember this room? It looks different with the lights on.
    playerChoices:
    - playerChoice: It does. How have you been?
      stressChange: 0
      nextDialogueIndex: 1
      endsDialogue: 0
    - playerChoice: See you later.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
  - npcDialogue: Busy, in a good way. I'm glad we're all here tonight.
    playerChoices:
    - playerChoice: Thanks. Talk to you later.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
