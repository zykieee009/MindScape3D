      nextDialogueIndex: -1
      endsDialogue: 1
  - npcDialogue: Just tidying the kitchen. It's nice when everything has its place.
    playerChoices:
    - playerChoice: Thanks. Talk to you later.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
