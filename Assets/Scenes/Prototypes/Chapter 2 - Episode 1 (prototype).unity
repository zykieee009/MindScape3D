--- !u!114 &2114672207
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2114672205}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4f0af065a22644d24964e2db23c993f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Dad
  modelPrefab: {fileID: 207754240948428144, guid: a4b03b22aa892401cae73b8454738ac9, type: 3}
  modelOffset: {x: 0, y: 0, z: 0}
  modelScale: 1
  interactionRadius: 3
  turnDuration: 0.3
  faceFocus: {fileID: 0}
  faceHeight: 1.65
  cameraDistance: 1.7
  cameraHeightOffset: 0.08
  enableDialogueChaining: 1
  dialogueNodes:
  - npcDialogue: Joey. Come and sit beside me for a moment. There is one thing a
      person carries everywhere, and it is the breath.
    playerChoices:
    - playerChoice: Why the breath?
      stressChange: 0
      nextDialogueIndex: 1
      endsDialogue: 0
    - playerChoice: I only have a moment.
      stressChange: 0
      nextDialogueIndex: 2
      endsDialogue: 0
  - npcDialogue: Because it is always here, in every kind of day. We do not have
      to find it or earn it. We only have to notice it.
    playerChoices:
    - playerChoice: How do I notice it?
      stressChange: 0
      nextDialogueIndex: 3
      endsDialogue: 0
  - npcDialogue: A moment is enough. A single breath takes only a few seconds, and
      it can be taken anywhere.
    playerChoices:
    - playerChoice: Alright.
      stressChange: 0
      nextDialogueIndex: 3
      endsDialogue: 0
  - npcDialogue: Then let us breathe together. In, and out, and we will see what
      we see.
    playerChoices:
    - playerChoice: Let's breathe.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
  modelInstance: {fileID: 2136013971}
