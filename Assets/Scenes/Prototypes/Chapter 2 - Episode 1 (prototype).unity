  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4f0af065a22644d24964e2db23c993f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Tim
  modelPrefab: {fileID: 207754240948428144, guid: a4b03b22aa892401cae73b8454738ac9, type: 3}
  modelOffset: {x: 0, y: 0, z: 0}
  modelScale: 0.65
  interactionRadius: 3
  turnDuration: 0.3
  faceFocus: {fileID: 0}
  faceHeight: 1.0725
  cameraDistance: 1.4
  cameraHeightOffset: 0.08
  enableDialogueChaining: 1
  dialogueNodes:
  - npcDialogue: Joey! When a door is open, is the room inside or outside?
    playerChoices:
    - playerChoice: Inside, I think.
      stressChange: 0
      nextDialogueIndex: 1
      endsDialogue: 0
    - playerChoice: Maybe both.
      stressChange: 0
      nextDialogueIndex: 2
      endsDialogue: 0
  - npcDialogue: Then a door is neither. It is the place where one room turns into
      another.
    playerChoices:
    - playerChoice: That makes sense.
      stressChange: 0
      nextDialogueIndex: 3
      endsDialogue: 0
  - npcDialogue: Both. Then a door is where two places meet.
    playerChoices:
    - playerChoice: It might be.
      stressChange: 0
      nextDialogueIndex: 3
      endsDialogue: 0
  - npcDialogue: The bus comes down the street, goes to school, and comes back again.
      It keeps moving, and the road stays where it is.
    playerChoices:
    - playerChoice: Goodbye, Tim.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
  modelInstance: {fileID: 1951130779}
