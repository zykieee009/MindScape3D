--- !u!114 &1668273441
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1668273439}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4f0af065a22644d24964e2db23c993f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Mom
  modelPrefab: {fileID: 207754240948428144, guid: a4b03b22aa892401cae73b8454738ac9, type: 3}
  modelOffset: {x: 0, y: 0, z: 0}
  modelScale: 1
  interactionRadius: 3
  turnDuration: 0.3
  faceFocus: {fileID: 0}
  faceHeight: 1.65
  cameraDistance: 1.7
  cameraHeightOffset: 0.08
  enableDialogueChaining: 1
  dialogueNodes:
  - npcDialogue: Good morning, Joey. There is breakfast on the table and lunch beside
      the door. A morning holds many small things, and each of them is only what
      it is.
    playerChoices:
    - playerChoice: What is today like?
      stressChange: 0
      nextDialogueIndex: 1
      endsDialogue: 0
    - playerChoice: I have a presentation today.
      stressChange: 0
      nextDialogueIndex: 2
      endsDialogue: 0
  - npcDialogue: Today is a day like any other, made of hours. Some of what fills
      them is planned, and some of it is not. Days have always been this way.
    playerChoices:
    - playerChoice: I see.
      stressChange: 0
      nextDialogueIndex: 3
      endsDialogue: 0
  - npcDialogue: Yes, I know. A presentation is a few minutes of speaking placed
      inside a long day. The rest of the day keeps going, as days do.
    playerChoices:
    - playerChoice: That is one way to see it.
      stressChange: 0
      nextDialogueIndex: 3
      endsDialogue: 0
  - npcDialogue: Your father is in the living room, and your brother is somewhere
      in the house. Before you go, shall we look at a thought together, the way a
      judge looks at a case, one piece of evidence at a time?
    playerChoices:
    - playerChoice: Alright.
      stressChange: 0
      nextDialogueIndex: -1
      endsDialogue: 1
  modelInstance: {fileID: 189973863}
